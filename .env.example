# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址调整；不要提交填写了真实密钥的 .env

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_NAME=qwen-flash
# 可在本地 .env 填写，或由宿主机注入；宿主机同名变量优先。
# DashScope 推荐使用 DASHSCOPE_API_KEY；其他 OpenAI 兼容服务可使用 OPENAI_API_KEY。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 允许访问 API 的前端来源，多个地址使用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent execution budgets. Run-level SLOs bound the complete workflow; phase
# limits below remain per-phase safety caps. Thorough is opt-in, not automatic.
AGENT_RECURSION_LIMIT=40
AGENT_MAX_RUNTIME_SECONDS=300
AGENT_HARD_MAX_RECURSION_LIMIT=160
AGENT_HARD_MAX_RUNTIME_SECONDS=1800
AGENT_QUICK_SLO_SECONDS=60
AGENT_STANDARD_SLO_SECONDS=180
AGENT_DEEP_SLO_SECONDS=300
AGENT_THOROUGH_SLO_SECONDS=900
AGENT_PHASE_CLARIFY_RECURSION_LIMIT=20
AGENT_PHASE_CLARIFY_TIMEOUT_SECONDS=120
AGENT_PHASE_RESEARCH_RECURSION_LIMIT=90
AGENT_PHASE_RESEARCH_TIMEOUT_SECONDS=900
AGENT_PHASE_COMPRESSION_RECURSION_LIMIT=40
AGENT_PHASE_COMPRESSION_TIMEOUT_SECONDS=240
AGENT_PHASE_FINAL_REPORT_RECURSION_LIMIT=60
AGENT_PHASE_FINAL_REPORT_TIMEOUT_SECONDS=420

# 网络搜索配置
# auto 按顺序自动降级；advanced 并发聚合所有可用后端
SEARCH_BACKEND=auto
SEARCH_BACKEND_ORDER=tavily,searxng,duckduckgo,perplexity
SEARCH_TIMEOUT=15
SEARCH_MAX_RESULTS=8
SEARCH_MAX_CONTENT_CHARS=8000

# DuckDuckGo 无需 API Key，安装依赖后可直接作为默认兜底
# Tavily、Perplexity 和 SearXNG 按需配置，未配置的后端会被自动跳过
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
SEARXNG_URL=http://localhost:8888

# 本地 RAG 基础设施
RAG_DATABASE_URL=postgresql+psycopg://deepsearch:deepsearch@localhost:5432/deepsearch_rag
RAG_REDIS_URL=redis://localhost:6379/0
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=knowledge_chunks
RAG_QDRANT_TIMEOUT_SECONDS=10
MEMORY_QDRANT_COLLECTION=user_memories
SHORT_TERM_MEMORY_BACKEND=postgres
SHORT_TERM_MEMORY_DATABASE_URL=
SHORT_TERM_MEMORY_POOL_SIZE=8
SHORT_TERM_MEMORY_FALLBACK_ENABLED=true
RAG_MINIO_ENDPOINT=localhost:9000
RAG_MINIO_ACCESS_KEY=deepsearch
RAG_MINIO_SECRET_KEY=deepsearch-secret
RAG_MINIO_BUCKET=knowledge-documents
RAG_MINIO_SECURE=false

# 文档不会发送到外部 embedding 服务；模型会在首次索引时下载到本机缓存
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANK_MODEL=BAAI/bge-reranker-base
FASTEMBED_CACHE_PATH=.fastembed_cache
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_VECTOR_TOP_K=24
RAG_LEXICAL_TOP_K=24
RAG_RERANK_TOP_K=8
RAG_MIN_RELEVANCE_SCORE=1.0
RAG_ANSWER_MAX_HITS=6
RAG_ANSWER_MAX_CONTEXT_CHARS=10000
MEMORY_TOP_K=6
MEMORY_MIN_CONFIDENCE=0.55

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# 宿主机直接运行 API 时使用 localhost + 映射端口；Docker Compose 会覆盖为 mysql:3306
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
DB_TIMEOUT_SECONDS=20
DB_TABLE_PREVIEW_ROWS=30
DB_QUERY_PREVIEW_ROWS=80
DB_MAX_RESULT_CHARS=12000
